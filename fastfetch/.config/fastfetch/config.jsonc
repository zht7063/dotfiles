{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.ansi",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 8
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;248;206;106",
      "title": "38;2;255;107;158"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[1;38;2;255;107;158m✦ \u001b[38;2;248;206;106mHe who desires but acts not, \u001b[38;2;180;111;242mbreeds pestilence.\u001b[0m"
    },
    "separator",
    {
      "type": "os",
      "key": "OS      "
    },
    {
      "type": "host",
      "key": "Host    "
    },
    {
      "type": "uptime",
      "key": "Uptime  "
    },
    {
      "type": "shell",
      "key": "Shell   "
    },
    {
      "type": "terminal",
      "key": "Term    "
    },
    {
      "type": "cpu",
      "key": "CPU     "
    },
    {
      "type": "memory",
      "key": "Memory  "
    },
    {
      "type": "disk",
      "key": "Disk    "
    },
    {
      "type": "battery",
      "key": "Battery "
    },
    {
      "type": "localip",
      "key": "IP      ",
      "showIpv4": true,
      "showIpv6": false
    },
    "break",
    "colors"
  ]
}
